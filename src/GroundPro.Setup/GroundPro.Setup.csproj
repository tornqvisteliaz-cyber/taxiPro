<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 ships with Windows 10 and 11: one small exe, no runtime to bundle (as HeavyProSetup). -->
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <AssemblyName>GroundProSetup</AssemblyName>
    <RootNamespace>GroundPro.Setup</RootNamespace>
    <ApplicationIcon>..\GroundPro.App\Assets\GroundPro.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\GroundPro.App\Assets\Logo.png" LogicalName="GroundPro.Setup.Logo.png" />
    <!-- The app itself: packaging/New-AppPayload.ps1 zips the app build; CI passes -p:PayloadZipPath=... -->
    <EmbeddedResource Include="$(PayloadZipPath)" LogicalName="GroundProPayload.zip" Condition="'$(PayloadZipPath)' != '' and Exists('$(PayloadZipPath)')" />
    <!-- The licensing library has no dependencies, so its source is compiled in and the setup stays one file. -->
    <Compile Include="..\Rotaidem.Licensing\*.cs" Link="Licensing\%(Filename)%(Extension)" />
    <Compile Include="..\Shared\GroundProLicense.cs" Link="GroundProLicense.cs" />
    <EmbeddedResource Include="..\..\packaging\licence-public-key.json" LogicalName="GroundPro.LicensePublicKey.json" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
